# KALYANI CAST TECH LIMITED — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or configure in hosting provider dashboard (e.g. Cloudflare Pages / Netlify / Vercel).
# NEVER commit real API keys or secrets to version control.

# -----------------------------------------------------------------------------
# 1. Canonical Site URL & SEO
# -----------------------------------------------------------------------------
# The canonical domain used in <link rel="canonical">, OpenGraph, and Twitter tags.
# Production default: https://kalyanicasttech.com
VITE_SITE_URL=https://kalyanicasttech.com

# -----------------------------------------------------------------------------
# 2. Commercial Enquiry Delivery Gateway (Resend / Transactional Email)
# -----------------------------------------------------------------------------
# Official corporate recipient email designated to receive commercial enquiries.
# Example: sales@kalyanicasttech.com or info@kalyanicasttech.com
ENQUIRY_RECIPIENT_EMAIL=

# API key from Resend (https://resend.com) for server-side transactional dispatch.
# Keep strictly server-side.
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# 3. Optional Database-Backed Enquiry Store (Supabase)
# -----------------------------------------------------------------------------
# If logging/storing commercial leads in a private database is required:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 4. Anti-Bot Protection (Cloudflare Turnstile)
# -----------------------------------------------------------------------------
# Optional Turnstile site key and secret key for captcha verification on enquiries:
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
